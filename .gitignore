# Dependencies (package-lock.json IS committed — root and sidecar)
node_modules/

# Secrets + per-install runtime state (seeded from discord-voice-config.example.json)
sidecar/discord-tokens.json
sidecar/discord-voice-config.json
# temp files of an atomic write (the tokens one holds the token) and copies kept of a config that could not be read
sidecar/*.tmp
sidecar/*.corrupt-*

# Config backups (backup.mjs) — contain the room password + resolved stream IDs
backups/

# verify scratch files
.verify-*.json

# verify-render screenshots (docs/ screenshots ARE committed)
/*-check.png

# the state files the backup tools may leave at the root
vdo-state-*.json
